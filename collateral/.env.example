# Copy to .env and fill in. Never commit .env. Never put a private key in this file for
# deployment: use `cast wallet import <name> --interactive` and pass --account <name>.

# ── deployment (script/DeployGoldVault.s.sol, script/DeployGoldPools.s.sol) ──
ETH_RPC_URL=
ETHERSCAN_API_KEY=
GOV=                    # multisig: timelock admin, guardian owner, pool pauser
# optional overrides (defaults in README "Risk parameters")
# TIMELOCK_DELAY=172800
# FLASH_MAX=500000000000000000000
# PAXG_MAT= PAXG_CHOP= PAXG_DUTY= PAXG_LINE= PAXG_DUST= PAXG_FLOOR=
# XAUT_MAT= XAUT_CHOP= XAUT_DUTY= XAUT_LINE= XAUT_DUST=
# GOLD_LINE_GLOBAL= XAU_MAX_AGE= PAXG_MAX_AGE=
# TREASURY= PSM_LINE= PSM_TIN= PSM_TOUT= PSM_FLOOR=
# pools (after the vault is deployed)
BXAU=
TIMELOCK=
# POOL_A=200 POOL_A_XAUT=100 POOL_FEE=4000000 POOL_STAKER_SHARE=5000000000

# ── keeper/keeper.mjs ──
RPC_URL=
VAULT=
PRIVATE_KEY=            # dedicated hot key holding gas money only; needed only with --execute
FLASH_KEEPER=
ROUTER=                 # the bXAU/<peg> GoldStablePool
ROUTE=stablepool
FROM_BLOCK=             # the vault's deployment block
# INTERVAL=30 MIN_PROFIT=0 BUFFER_BPS=10 ROUTE_SLIPPAGE_BPS=10 GAS_MARGIN_PCT=30

# ── keeper/monitor.mjs ──
GUARDIAN=
FLASH=
PSM=
POOLS=                  # comma-separated pool addresses
WEBHOOK_URL=
# UTIL_WARN=90 IMBALANCE_WARN=20
