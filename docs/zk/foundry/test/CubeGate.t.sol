pragma solidity ^0.8.24;

import {ZkTest, Actor} from "./ZkTest.sol";
import {CubeProof} from "./fixtures/CubeProof.sol"; // generated by circom/build.sh
import {CubeVerifier} from "../src/verifiers/CubeVerifier.sol"; // generated by circom/build.sh
import {CubeGate, IGroth16Verifier} from "../src/CubeGate.sol";

contract CubeGateTest is ZkTest {
    CubeVerifier verifier;
    CubeGate gate;
    Actor alice;
    Actor mallory;

    function setUp() public {
        verifier = new CubeVerifier();
        gate = new CubeGate(IGroth16Verifier(address(verifier)));
        alice = new Actor();
        mallory = new Actor();
    }

    function _enter(uint256 statement) internal pure returns (bytes memory) {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = CubeProof.get();
        pub[0] = statement;
        return abi.encodeCall(CubeGate.enter, (a, b, c, pub));
    }

    function test_validProofVerifies() public view {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = CubeProof.get();
        assertEq(pub[0], 35); // the public signal IS the statement
        assertTrue(verifier.verifyProof(a, b, c, pub));
    }

    function test_gateAdmitsProver() public {
        mustSucceed(alice, address(gate), _enter(35));
        assertTrue(gate.entered(address(alice)));
    }

    function test_tamperedPublicSignalFails() public view {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = CubeProof.get();
        pub[0] = 36; // same proof, different statement
        assertFalse(verifier.verifyProof(a, b, c, pub));
    }

    function test_tamperedProofFails() public view {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = CubeProof.get();
        a[1] = a[1] ^ 1; // knock pi_a off the curve
        assertFalse(verifier.verifyProof(a, b, c, pub));
    }

    function test_wrongStatementRejectedByGate() public {
        expectRevert(alice, address(gate), _enter(36), CubeGate.WrongStatement.selector);
    }

    /// The documented flaw: the proof is not bound to the caller, so Mallory replays Alice's
    /// proof from the mempool and gets in too. Fix: bind the beneficiary into the statement —
    /// see ZkAirdrop (recipient is a public signal) and KeyRegistry (msg.sender is hashed).
    function test_replayIsPossible_documentedFlaw() public {
        mustSucceed(alice, address(gate), _enter(35));
        mustSucceed(mallory, address(gate), _enter(35));
        assertTrue(gate.entered(address(mallory)));
    }
}
