pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {Groth16Verifier} from "../src/Groth16Verifier.sol"; // generated by ../circom/prove.sh
import {CubeGate, IGroth16Verifier} from "../src/CubeGate.sol";

contract CubeGateTest is Test {
    Groth16Verifier verifier;
    CubeGate gate;

    function setUp() public {
        verifier = new Groth16Verifier();
        gate = new CubeGate(IGroth16Verifier(address(verifier)));
    }

    /// proof/calldata.hex is written by encode-proof.mjs from snarkjs proof.json + public.json
    function _load()
        internal
        view
        returns (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub)
    {
        bytes memory raw = vm.parseBytes(vm.readFile("proof/calldata.hex"));
        (a, b, c, pub) = abi.decode(raw, (uint256[2], uint256[2][2], uint256[2], uint256[1]));
    }

    function test_validProofVerifies() public view {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = _load();
        assertEq(pub[0], 35, "public signal is the statement");
        assertTrue(verifier.verifyProof(a, b, c, pub));
    }

    function test_gateAdmitsProver() public {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = _load();
        address alice = makeAddr("alice");
        vm.prank(alice);
        gate.enter(a, b, c, pub);
        assertTrue(gate.entered(alice));
    }

    function test_tamperedPublicSignalFails() public view {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = _load();
        pub[0] = 36; // claim a different statement with the same proof
        assertFalse(verifier.verifyProof(a, b, c, pub));
    }

    function test_tamperedProofFails() public view {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = _load();
        a[1] = a[1] ^ 1; // knock pi_a off the curve
        assertFalse(verifier.verifyProof(a, b, c, pub));
    }

    function test_wrongStatementRejectedByGate() public {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = _load();
        pub[0] = 36;
        vm.expectRevert(CubeGate.WrongStatement.selector);
        gate.enter(a, b, c, pub);
    }

    /// Demonstrates the flaw documented on CubeGate: the proof is not bound to the caller,
    /// so an observer replays Alice's proof from the mempool and gets in too.
    function test_replayIsPossible_documentedFlaw() public {
        (uint256[2] memory a, uint256[2][2] memory b, uint256[2] memory c, uint256[1] memory pub) = _load();
        vm.prank(makeAddr("alice"));
        gate.enter(a, b, c, pub);
        address mallory = makeAddr("mallory");
        vm.prank(mallory);
        gate.enter(a, b, c, pub); // succeeds — fix: bind msg.sender into the public signals
        assertTrue(gate.entered(mallory));
    }
}
